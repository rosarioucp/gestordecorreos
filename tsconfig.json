{
  "compilerOptions": {
    // Módulos: usamos import/export modernos (ES Modules)
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "esnext",
    "types": [],

    // No genera archivos .js: solo controla los tipos (Vitest ejecuta el .ts directo)
    "noEmit": true,

    // Chequeo de tipos estricto (lo pide la consigna)
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    // Opciones recomendadas
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true
  },
  // Carpetas que TypeScript revisa
  "include": ["src", "tests"]
}